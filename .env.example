# 复制此文件为 .env 并填入真实 key（.env 已被 .gitignore，不会入库）
# 注意：.env 里的 key 是密钥，不要提交到 git
#
# 快速开始：
#   1. 复制本文件为 .env: cp .env.example .env
#   2. 填入下方各 API Key
#   3. 运行: npm run setup  （自动装依赖 + 检测环境）
#   4. 运行: node scripts/case-publish.mjs <slug>  （出片）

# =========================================================
# TTS 配音服务（scripts/case-tts.mjs 用）
# 通过 TTS_PROVIDER 选择，可在命令行临时覆盖：
#   TTS_PROVIDER=say node scripts/case-publish.mjs <slug>
# =========================================================
TTS_PROVIDER=volcano        # volcano(默认,火山) | elevenlabs | say

# ---- 火山引擎 · 豆包语音合成大模型 (Seed TTS) ----
# 开通：火山引擎控制台 → 语音技术 → 创建应用 → 开通「语音合成大模型(Seed TTS)」
# 控制台：https://console.volcengine.com/speech/new
# 鉴权支持两套，任选其一：
#   新版控制台：用 VOLCANO_API_KEY（单个 API Key）
#   旧版控制台：用 VOLCANO_APP_ID + VOLCANO_ACCESS_KEY
VOLCANO_API_KEY=
# VOLCANO_APP_ID=
# VOLCANO_ACCESS_KEY=

# 模型版本(决定可用音色与计费)。seed-tts-2.0 只能用"2.0音色"，seed-tts-1.0 用"1.0音色"
VOLCANO_RESOURCE_ID=seed-tts-2.0

# 音色 speaker id：在控制台「发音人列表」里复制（形如 zh_male_xxx_bigtts）
# 示例（需替换成你账号里实际开通可用的 id）：
#   zh_female_shuangkuaisisi_mars_bigtts  （2.0 音色）
#   zh_male_xxx_bigtts                     （你账号的男声）
VOLCANO_SPEAKER=
VOLCANO_SAMPLE_RATE=24000

# ---- ElevenLabs API Key（可选，若 TTS_PROVIDER=elevenlabs）----
# 去 https://elevenlabs.io/ 申请
# ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=

# =========================================================
# Pexels API Key（B-roll 视频素材下载，免费）
# 注册：https://www.pexels.com/api/  → 免费注册 → 获取 API Key
# =========================================================
PEXELS_API_KEY=

# =========================================================
# Chrome 浏览器路径（可选，渲染引擎用）
# 默认自动检测系统 Chrome，找不到时自动下载 Chromium。
# 如需手动指定，取消注释并修改：
# =========================================================
# CHROME_EXECUTABLE="/Applications/Google Chrome.app/Contents/MacOS/Google Chrome"