# 复制此文件为 .env 并填入真实 key（.env 已被 .gitignore，不会入库）
# 注意：.env 里的 key 是密钥，不要提交到 git
#
# 快速开始：
#   1. 复制本文件为 .env: cp .env.example .env
#   2. 填入下方各 API Key
#   3. 运行: npm run setup  （自动装依赖 + 检测环境）
#   4. 运行: node scripts/case-publish.mjs <slug>  （出片）

# =========================================================
# TTS 配音服务（scripts/case-tts.mjs 用）
# 通过 TTS_PROVIDER 选择，可在命令行临时覆盖：
#   TTS_PROVIDER=auto node scripts/case-publish.mjs <slug>
# =========================================================
TTS_PROVIDER=auto           # auto(默认:本地MOSS优先,否则按平台免费) | moss | volcano(推荐) | openai | azure | google | elevenlabs
                            # macOS 免费: say (系统自带，零配置)
                            # Windows 免费: powershell (系统自带，零配置)
                            # Linux 免费: espeak (需 apt install espeak-ng)

# ---- MOSS-TTS-Nano 本地真人 TTS（auto 默认首选，免 Key、中文真人感）----
# 开源：https://github.com/OpenMOSS/MOSS-TTS-Nano （Apache-2.0，CPU 实时，0.1B + 20M tokenizer）
# 部署（一次性，详见 README-ZH.md「本地 MOSS-TTS」）：
#   git clone https://github.com/OpenMOSS/MOSS-TTS-Nano.git && cd MOSS-TTS-Nano
#   pip install -r requirements.txt && pip install -e .
#   moss-tts-nano serve        # 常驻服务，默认 http://127.0.0.1:18083（首启约 5 分钟下载模型）
# auto 模式下脚本会自动探测该服务，可达则用 moss，不可达则按平台回落免费 TTS。
#MOSS_TTS_BASE_URL=http://127.0.0.1:18083   # 服务地址覆盖（默认即可）
#MOSS_PROMPT_AUDIO=                            # 可选：3 秒参考音频路径 → 语音克隆（给品牌固声线）
#MOSS_DEMO_ID=demo-1                           # 内置音色选择（默认 demo-1 案例讲解/商务；见 README-ZH「本地 MOSS-TTS」音色清单）

# ---- 火山引擎 · 豆包语音合成大模型 (Seed TTS) ----
# 开通：火山引擎控制台 → 语音技术 → 创建应用 → 开通「语音合成大模型(Seed TTS)」
# 控制台：https://console.volcengine.com/speech/new
# 鉴权支持两套，任选其一：
#   新版控制台：用 VOLCANO_API_KEY（单个 API Key）
#   旧版控制台：用 VOLCANO_APP_ID + VOLCANO_ACCESS_KEY
VOLCANO_API_KEY=
# VOLCANO_APP_ID=
# VOLCANO_ACCESS_KEY=

# 模型版本(决定可用音色与计费)。seed-tts-2.0 只能用"2.0音色"，seed-tts-1.0 用"1.0音色"
VOLCANO_RESOURCE_ID=seed-tts-2.0

# 音色 speaker id：在控制台「发音人列表」里复制（形如 zh_male_xxx_bigtts）
# 示例（需替换成你账号里实际开通可用的 id）：
#   zh_female_shuangkuaisisi_mars_bigtts  （2.0 音色）
#   zh_male_xxx_bigtts                     （你账号的男声）
VOLCANO_SPEAKER=
VOLCANO_SAMPLE_RATE=24000

# ---- ElevenLabs（可选，若 TTS_PROVIDER=elevenlabs）----
# 去 https://elevenlabs.io/ 申请
# ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=

# ---- OpenAI TTS（可选，若 TTS_PROVIDER=openai）----
# 去 https://platform.openai.com/ 申请 API Key
# OPENAI_API_KEY=
# OPENAI_TTS_VOICE=alloy        # alloy | echo | fable | onyx | nova | shimmer
# OPENAI_TTS_MODEL=tts-1        # tts-1 | tts-1-hd

# ---- Azure Speech（可选，若 TTS_PROVIDER=azure）----
# 去 https://portal.azure.com 创建 Speech 资源
# AZURE_SPEECH_KEY=
# AZURE_SPEECH_REGION=eastasia
# AZURE_SPEECH_VOICE=zh-CN-XiaoxiaoNeural

# ---- Google Cloud TTS（可选，若 TTS_PROVIDER=google）----
# 去 https://console.cloud.google.com 启用 Text-to-Speech API，创建服务账号并下载 JSON 密钥
# GOOGLE_TTS_CREDENTIALS=         # JSON 字符串或文件路径
# GOOGLE_TTS_VOICE=zh-CN-Standard-A

# =========================================================
# Pexels API Key（B-roll 视频素材下载，免费）
# 注册：https://www.pexels.com/api/  → 免费注册 → 获取 API Key
# =========================================================
PEXELS_API_KEY=

# =========================================================
# Chrome 浏览器路径（可选，渲染引擎用）
# 默认自动检测系统 Chrome，找不到时自动下载 Chromium。
# 如需手动指定，取消注释并修改：
# =========================================================
# CHROME_EXECUTABLE="/Applications/Google Chrome.app/Contents/MacOS/Google Chrome"